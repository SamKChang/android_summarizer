<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="gist_secure_prefs.xml" />
        <exclude domain="database" path="gist.db" />
        <exclude domain="database" path="gist.db-shm" />
        <exclude domain="database" path="gist.db-wal" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="gist_secure_prefs.xml" />
        <exclude domain="database" path="gist.db" />
        <exclude domain="database" path="gist.db-shm" />
        <exclude domain="database" path="gist.db-wal" />
    </device-transfer>
</data-extraction-rules>
